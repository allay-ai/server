 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1
   },
   {
    "name": "logs",
    "label": "Loki",
    "type": "datasource",
    "query": "loki",
    "current": {},
    "hide": 0,
    "refresh": 1
   },
   {
    "name": "traces",
    "label": "Tempo",
    "type": "datasource",
    "query": "tempo",
    "current": {},
    "hide": 0,
    "refresh": 1
   },
   {
    "name": "tenant",
    "label": "Tenant",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "query": {
     "query": "label_values(allay_runs_total, tenant)",
     "refId": "tenant"
    },
    "definition": "label_values(allay_runs_total, tenant)",
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1
   },
   {
    "name": "server",
    "label": "Server",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "query": {
     "query": "label_values(allay_runs_total{tenant=~\"$tenant\"}, server_id)",
     "refId": "server"
    },
    "definition": "label_values(allay_runs_total{tenant=~\"$tenant\"}, server_id)",
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1
   }
  ]
 },

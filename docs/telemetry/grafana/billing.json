      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(increase(allay_runs_total{kind!=\"summary\", tenant=~\"$tenant\", server_id=~\"$server\", payer=\"license\"}[$__range])) / sum(increase(allay_runs_total{kind!=\"summary\", tenant=~\"$tenant\", server_id=~\"$server\"}[$__range]))",

  {
   "type": "stat",
   "title": "Cost",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(increase(allay_cost_usage_total{tenant=~\"$tenant\", server_id=~\"$server\"}[$__range]))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto"

  {
   "type": "timeseries",
   "title": "Cost by server",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "topk(10, sum by (tenant, server_id) (rate(allay_cost_usage_total{tenant=~\"$tenant\", server_id=~\"$server\"}[$__rate_interval])) * on (tenant, server_id) group_left (name) max by (tenant, server_id, name) (allay_server_info)) * 3600",
     "legendFormat": "{{name}} · {{tenant}}",
     "exemplar": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [

  {
   "type": "timeseries",
   "title": "Cost by source",
   "description": "Dollars an hour.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (source) (rate(allay_cost_usage_total{tenant=~\"$tenant\", server_id=~\"$server\"}[$__rate_interval])) * 3600",
     "legendFormat": "{{source}}",
     "exemplar": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 20,
      "showPoints": "never",
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []

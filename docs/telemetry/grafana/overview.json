  {
   "type": "stat",
   "title": "Questions",
   "description": "Questions, askx requests, and agents' wakes in the time range.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(increase(allay_runs_total{kind!=\"summary\", tenant=~\"$tenant\", server_id=~\"$server\"}[$__range]))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto"
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4

{
 "uid": "allay-overview",
 "title": "Allay · Overview",
 "description": "Runs, errors, latency, cost, and load of the Allay backend, per server or in total, from its OpenTelemetry metrics.",
 "tags": [
  "allay"
 ],
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 41,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1
   },
   {
    "name": "logs",
    "label": "Loki",
    "type": "datasource",
    "query": "loki",
    "current": {},
    "hide": 0,
    "refresh": 1
   },
   {
    "name": "traces",
    "label": "Tempo",
    "type": "datasource",
    "query": "tempo",
    "current": {},
    "hide": 0,
    "refresh": 1
   },
   {
    "name": "tenant",
    "label": "Tenant",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "query": {
     "query": "label_values(allay_runs_total, tenant)",
     "refId": "tenant"
    },
    "definition": "label_values(allay_runs_total, tenant)",
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1
   },
   {
    "name": "server",
    "label": "Server",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "query": {
     "query": "label_values(allay_runs_total{tenant=~\"$tenant\"}, server_id)",
     "refId": "server"
    },
    "definition": "label_values(allay_runs_total{tenant=~\"$tenant\"}, server_id)",
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "links": [
  {
   "title": "Allay",
   "type": "dashboards",
   "tags": [

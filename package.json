{
  "name": "allay-server",
  "description": "🛠️⚡ Бэкенд для AI-помощника Allay — агент на Mastra с инструментами игры и веб-поиском, стриминг ответов в Minecraft, совместимый API для Telegram. 🌟",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/application/entrypoint.ts --outdir dist/application --target bun && bun build src/features/tools/calc.worker.ts --outdir dist/application --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "minecraft",
    "ai",
    "assistant",
    "openrouter",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bun": "latest",
    "@types/ioredis": "^5.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@ai-sdk/provider": "^4.0.26",
    "@mastra/core": "1.78.0",
    "@mastra/mongodb": "1.23.1",
    "@mastra/observability": "1.20.1",
    "@mastra/perplexity": "0.2.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.137",
    "amqplib": "^0.10.9",
    "bullmq": "^5.65.0",
    "ioredis": "^5.8.2",
    "mathjs": "^15.2.0",
    "mongoose": "^9.0.0",
    "tslog": "^4.10.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}

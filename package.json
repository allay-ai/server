{
  "name": "allay-server",
  "description": "🛠️⚡ Бэкенд для AI-помощника Allay — агент на Mastra с инструментами игры и веб-поиском, стриминг ответов в Minecraft, совместимый API для Telegram. 🌟",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/application/entrypoint.ts --outdir dist/application --target bun && bun build src/application/migrate.ts --outdir dist/application --target bun && bun build src/application/reveal.ts --outdir dist/application --target bun && bun build src/features/tools/calc.worker.ts --outdir dist/application --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "minecraft",
    "ai",
    "assistant",
    "openrouter",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.84",
    "@ai-sdk/provider": "4.0.35",
    "@mastra/core": "1.82.0",
    "@mastra/mongodb": "1.26.0",
    "@mastra/observability": "1.23.1",
    "@mastra/perplexity": "0.2.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.0",
    "@opentelemetry/exporter-prometheus": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "ai": "7.0.162",
    "gpt-tokenizer": "4.1.0",
    "mathjs": "^15.2.0",
    "mongoose": "^9.12.0",
    "tslog": "^5.5.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}

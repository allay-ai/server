# Services

## Headers

API_URL=<need to be configured>
API_NAME=<need to be configured>

## MongoDB

# MongoDB starts with this root user and wants it from everyone; MONGODB_URI below carries the same.
MONGO_INITDB_ROOT_USERNAME=<need to be configured>
MONGO_INITDB_ROOT_PASSWORD=<need to be configured>
MONGO_INITDB_DATABASE=<need to be configured>
MONGODB_DATABASE=<need to be configured>

## Redis

REDIS_HOST=<need to be configured>
REDIS_PORT=<need to be configured>
REDIS_PASSWORD=<need to be configured>
REDIS_DB=<need to be configured>

## Application

PORT=<need to be configured>
NODE_ENV=<need to be configured>

CHAT_TTL_SECONDS=<need to be configured>

# mongodb://<user>:<password>@allay-server-mongo:27017/?authSource=admin
MONGODB_URI=<need to be configured>
REDIS_URL=<need to be configured>

OPENROUTER_API_KEY=<need to be configured>
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# The agent's model must support tool calling (perplexity/sonar* doesn't).
OPENROUTER_API_MODEL=openai/gpt-6-luna
# Search context size for search_web: low, medium, high.
OPENROUTER_API_CTX=medium
# Online model used by search_web without a Perplexity key, and for servers with their own key.
SEARCH_MODEL=perplexity/sonar
# Optional: Perplexity's Search API for search_web on this backend's key, faster and cheaper than the search model.
PERPLEXITY_API_KEY=
# Optional: the share of runs traced into MongoDB (1 self-hosted, 0.1 hosted by default; 0 turns it off) and for how many days.
TRACE_SAMPLE=
TRACE_DAYS=7
# Optional: low, medium, high for models that reason.
OPENROUTER_REASONING_EFFORT=

## Access

# The token every plugin sends (server.token in its config.yml); a self-hosted backend answers no plugin without one.
# At least 24 characters: openssl rand -hex 24
PLUGIN_TOKEN=
# Addresses and CIDR ranges of the reverse proxies in front of the backend; only their X-Forwarded-For counts.
TRUSTED_PROXIES=

## Billing

# 1 on a server's own backend: everyone runs on this backend's key, nobody pays.
SELFHOSTED=
# The payment bot; without it there are no payment links.
TELEGRAM_BOT_TOKEN=
# Telegram user ids, comma-separated, that may /refund in the bot.
TELEGRAM_ADMIN_IDS=
# 1 for local runs: take updates by polling instead of the webhook at API_URL.
TELEGRAM_POLLING=

## Agent

TOOL_TIMEOUT_MS=15000
MAX_AGENT_STEPS=8
MAX_ACTIVE_RUNS=200
SSE_PING_MS=15000

# Proxy Configuration

HTTP_PROXY=<need to be configured>
